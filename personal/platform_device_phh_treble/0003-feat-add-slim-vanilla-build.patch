From 0c7b48b17a2556ed183934ae840318eba5faa169 Mon Sep 17 00:00:00 2001
From: mytja <mitja@severkar.eu>
Date: Thu, 5 Sep 2024 19:02:20 +0200
Subject: [PATCH 3/6] feat: add slim & vanilla build

Co-authored-by: ahnet-69 <syedmusicrealise@gmail.com>
Change-Id: I4823c831a2355a4d1811e83a2eded0755702b91a
---
 generate.sh | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/generate.sh b/generate.sh
index 461eff1..8972f23 100644
--- a/generate.sh
+++ b/generate.sh
@@ -15,7 +15,7 @@ fi
 echo 'PRODUCT_MAKEFILES := \' > AndroidProducts.mk
 
 for part in a ab;do
-	for apps in vanilla gapps foss gapps-go;do
+	for apps in vanilla gapps foss slim;do
 		for arch in arm64 arm a64;do
 			for su in yes no;do
 				apps_suffix=""
@@ -23,16 +23,18 @@ for part in a ab;do
 				apps_name=""
 				extra_packages=""
                 vndk="vndk.mk"
-		optional_base=""
+				optional_base=""
+				file_suffix=""
 				if [ "$apps" == "gapps" ];then
 					apps_suffix="g"
-					apps_script='$(call inherit-product, device/phh/treble/gapps.mk)'
+					apps_script=''
 					apps_name="with GApps"
 				fi
-				if [ "$apps" == "gapps-go" ];then
-					apps_suffix="o"
-					apps_script='$(call inherit-product, device/phh/treble/gapps-go.mk)'
-					apps_name="Go"
+				if [ "$apps" == "slim" ];then
+					apps_suffix="g"
+					apps_script='TARGET_USES_PICO_GAPPS := true'
+					apps_name="with Slim GApps"
+					file_suffix='_slim'
 				fi
 				if [ "$apps" == "foss" ];then
 					apps_suffix="f"
@@ -41,7 +43,7 @@ for part in a ab;do
 				fi
 				if [ "$apps" == "vanilla" ];then
 					apps_suffix="v"
-					apps_script=''
+					apps_script='WITH_GMS := false'
 					apps_name="vanilla"
 				fi
 				if [ "$arch" == "arm" ];then
@@ -64,7 +66,7 @@ for part in a ab;do
 					optional_base='$(call inherit-product, device/phh/treble/base-sas.mk)'
 				fi
 
-				target="treble_${arch}_${part_suffix}${apps_suffix}${su_suffix}"
+				target="treble_${arch}_${part_suffix}${apps_suffix}${su_suffix}${file_suffix}"
 
 				baseArch="$arch"
 				if [ "$arch" = "a64" ];then
-- 
2.34.1

